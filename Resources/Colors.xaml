<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Industrial Orange Palette (matching web project) -->
  <!-- Gray Scale -->
  <Color x:Key="Gray50">#FAF8F6</Color>
  <Color x:Key="Gray100">#F3F0ED</Color>
  <Color x:Key="Gray200">#E8E3DE</Color>
  <Color x:Key="Gray300">#D1C9C1</Color>
  <Color x:Key="Gray400">#9C938A</Color>
  <Color x:Key="Gray500">#6B6259</Color>
  <Color x:Key="Gray600">#4B4239</Color>
  <Color x:Key="Gray700">#37302A</Color>
  <Color x:Key="Gray800">#1F1B17</Color>
  <Color x:Key="Gray900">#14110E</Color>

  <!-- Orange Primary (Industrial) -->
  <Color x:Key="Orange500">#FF6A00</Color>
  <Color x:Key="Orange600">#E05E00</Color>
  <Color x:Key="Orange700">#C45200</Color>
  <Color x:Key="Orange50">#FFF4EB</Color>

  <!-- Blue (Info) -->
  <Color x:Key="Blue50">#EFF6FF</Color>
  <Color x:Key="Blue500">#3B82F6</Color>
  <Color x:Key="Blue600">#2563EB</Color>
  <Color x:Key="Blue700">#1D4ED8</Color>

  <!-- Green (Success) -->
  <Color x:Key="Green50">#F0FDF4</Color>
  <Color x:Key="Green500">#10B981</Color>
  <Color x:Key="Green600">#059669</Color>

  <!-- Amber (Warning) -->
  <Color x:Key="Amber50">#FFFBEB</Color>
  <Color x:Key="Amber500">#F59E0B</Color>
  <Color x:Key="Amber600">#D97706</Color>

  <!-- Red (Error/Destructive) -->
  <Color x:Key="Red50">#FEF2F2</Color>
  <Color x:Key="Red500">#EF4444</Color>
  <Color x:Key="Red600">#DC2626</Color>

  <!-- Sidebar Colors -->
  <Color x:Key="SidebarDark">#3D1A08</Color>
  <Color x:Key="SidebarDarkAlt">#4A2010</Color>
  <Color x:Key="SidebarHover">#5C2D15</Color>
  <Color x:Key="SidebarText">#F5E6D8</Color>

  <!-- Color Brushes -->
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Orange500}" />
  <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource Orange700}" />
  <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Gray500}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Green500}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Amber500}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Red500}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Blue500}" />
  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Gray50}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Gray100}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Gray900}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Gray600}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Gray200}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarDark}" />
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHover}" />
  <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarText}" />

</ResourceDictionary>
