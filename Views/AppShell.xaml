<UserControl x:Class="TTXEquipamentos.Views.AppShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1366"
             Background="{StaticResource BackgroundBrush}">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" CornerRadius="0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#3D1A08" Offset="0"/>
          <GradientStop Color="#2A1005" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel>
        <!-- Logo Area -->
        <Border DockPanel.Dock="Top" Padding="20,24,20,20">
          <StackPanel>
            <TextBlock Text="TTX Equipamentos" FontSize="18" FontWeight="Bold" Foreground="#F5E6D8"/>
            <TextBlock Text="Sistema de Manutenção" FontSize="12" Foreground="#B08968" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>

        <!-- Separator -->
        <Border DockPanel.Dock="Top" Height="1" Background="#5C2D15" Margin="16,0"/>

        <!-- Bottom User Info -->
        <Border DockPanel.Dock="Bottom" Padding="16,12" Background="#2A1005">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock x:Name="CurrentUserNameTextBlock" Text="Usuário" 
                         FontSize="13" FontWeight="SemiBold" Foreground="#F5E6D8"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="CurrentUserRoleTextBlock" Text="Administrador" 
                         FontSize="11" Foreground="#B08968"/>
            </StackPanel>

            <Button Grid.Column="1" Content="Sair" Click="LogoutButton_Click"
                    Padding="12,6" FontSize="12" Cursor="Hand"
                    Background="#EF4444" Foreground="White" BorderThickness="0">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </Grid>
        </Border>

        <!-- Menu Items -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel x:Name="SidebarMenu" Margin="8,0"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Main Content Area -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Top Header Bar -->
      <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="24,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="PageTitleTextBlock" Grid.Column="0" Text="Dashboard"
                     FontSize="16" FontWeight="SemiBold" 
                     Foreground="{StaticResource TextPrimaryBrush}"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="HeaderUserText" Grid.Column="1" 
                     FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                     VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- Page Frame -->
      <Frame x:Name="MainContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
  </Grid>
</UserControl>
