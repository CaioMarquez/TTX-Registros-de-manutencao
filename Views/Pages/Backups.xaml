<Page x:Class="TTXEquipamentos.Views.Pages.Backups"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}"
      Title="Backups">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24" MaxWidth="800" HorizontalAlignment="Left">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock Text="Backups e Restauração" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="Gerencie os arquivos de backup do sistema" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,4,0,0"/>
      </StackPanel>

      <!-- Backup Card -->
      <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="32" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Exportar Backup" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
          <TextBlock Text="Salva todos os dados do sistema em um arquivo ZIP compactado." Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,8,0,24" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding DataFolder, StringFormat='Pasta de dados: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,24" TextWrapping="Wrap"/>
          <Button Content="📁  Gerar Backup Agora"
                  Command="{Binding BackupCommand}"
                  Style="{StaticResource PrimaryButton}"
                  Background="{StaticResource SuccessBrush}" BorderBrush="{StaticResource SuccessBrush}"
                  Foreground="White" Height="48" FontSize="14" Cursor="Hand"
                  HorizontalAlignment="Left" Padding="24,0"/>
        </StackPanel>
      </Border>

      <!-- Restore Card -->
      <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="32" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="⚠  Restaurar Backup" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}"/>
          <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,8,0,24">
            <Run Foreground="{StaticResource ErrorBrush}" FontWeight="SemiBold">ATENÇÃO: </Run>
            <Run Foreground="{StaticResource TextSecondaryBrush}">Esta operação substituirá todos os dados atuais pelos dados do arquivo de backup. Esta ação não pode ser desfeita.</Run>
          </TextBlock>
          <Button Content="📂  Restaurar a partir de Backup"
                  Command="{Binding RestoreCommand}"
                  Style="{StaticResource DangerButton}"
                  Background="{StaticResource ErrorBrush}" BorderBrush="{StaticResource ErrorBrush}"
                  Foreground="White" Height="48" FontSize="14" Cursor="Hand"
                  HorizontalAlignment="Left" Padding="24,0"/>
        </StackPanel>
      </Border>

      <!-- Status Message -->
      <TextBlock Text="{Binding StatusMessage}" Grid.Row="4" VerticalAlignment="Bottom" Margin="0,100,0,0"
                 Foreground="{StaticResource SuccessBrush}" FontSize="14" FontWeight="SemiBold"/>
    </Grid>
  </ScrollViewer>
</Page>