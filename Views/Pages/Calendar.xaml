<Page x:Class="TTXEquipamentos.Views.Pages.Calendar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}"
      Title="Calendário">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="24"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="24"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Calendário de Preventivas" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
      <TextBlock Text="Planejamento mensal de manutenções preventivas" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Month Navigation -->
    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="&lt;" Command="{Binding PrevMonthCommand}"
                Style="{StaticResource SecondaryButton}"
                Foreground="{StaticResource TextPrimaryBrush}"
                Width="40" Height="40" FontSize="18"/>
        <TextBlock Text="{Binding CurrentMonthLabel}" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   VerticalAlignment="Center" Margin="16,0" MinWidth="220" TextAlignment="Center"/>
        <Button Content="&gt;" Command="{Binding NextMonthCommand}"
                Style="{StaticResource SecondaryButton}"
                Foreground="{StaticResource TextPrimaryBrush}"
                Width="40" Height="40" FontSize="18"/>
      </StackPanel>
    </Border>

    <!-- Scheduled Items -->
    <Border Grid.Row="4" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
      <Grid>
        <DataGrid ItemsSource="{Binding ScheduledItems}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderThickness="0" RowHeight="56" Background="Transparent"
                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  >
          <DataGrid.Columns>
            <DataGridTextColumn Header="Data" Binding="{Binding ScheduledDate, StringFormat=dd/MM/yyyy}" FontWeight="SemiBold" Width="130"/>
            <DataGridTextColumn Header="Semana" Binding="{Binding WeekNumber}" Width="100"/>
            <DataGridTextColumn Header="Máquina" Binding="{Binding MachineTag}" Width="150"/>
            <DataGridTextColumn Header="Tipo" Binding="{Binding MaintenanceType}" Width="130"/>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Empty State -->
        <TextBlock Text="Nenhuma preventiva agendada para este mês."
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="15"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding ScheduledItems.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
      </Grid>
    </Border>
  </Grid>
</Page>