<Page x:Class="TTXEquipamentos.Views.Pages.ExtraCosts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}"
      Title="Custos Extras">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      
      <!-- Header -->
      <StackPanel Margin="0,0,0,24">
        <TextBlock Text="Custos Extras" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="Gestão de mão de obra terceirizada" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,4,0,0"/>
      </StackPanel>

      <!-- Summary Card - Total Costs for Year -->
      <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,24">
        <StackPanel>
          <TextBlock Text="Total Mão de Obra Extra (2026)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
          <TextBlock Text="{Binding TotalCostsFormatted}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <!-- Two Column Grid: Contractors and Cost Entry -->
      <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="24"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Prestadores de Serviço Section -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <StackPanel Margin="20">
            <TextBlock Text="Prestadores de Serviço" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

            <!-- Add Contractor Form - Admin only -->
            <StackPanel Margin="0,0,0,12" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
              <Border Background="{StaticResource BackgroundBrush}" CornerRadius="4" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="Novo Prestador" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                  
                  <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Nome *" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding NewContractorName, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Ex: Elétrica Silva"
                             Background="White"
                             Foreground="Black"
                             CaretBrush="Black"
                             Height="36"/>
                  </StackPanel>

                  <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Especialidade" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding NewContractorSpecialty, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Ex: Elétrica"
                             Background="White"
                             Foreground="Black"
                             CaretBrush="Black"
                             Height="36"/>
                  </StackPanel>

                  <Button Content="Cadastrar Prestador" 
                          Command="{Binding AddContractorCommand}"
                          Style="{StaticResource PrimaryButton}"
                          Background="{StaticResource PrimaryBrush}"
                          Foreground="White"
                          Height="36"
                          />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Contractors List -->
            <TextBlock Text="" Margin="0,0,0,12"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="300">
              <ItemsControl ItemsSource="{Binding Contractors}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="White" CornerRadius="4" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                          <TextBlock Text="{Binding Specialty}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Visibility="{Binding Specialty, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Command="{Binding DataContext.DeleteContractorCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource SecondaryButton}"
                                Foreground="{StaticResource ErrorBrush}"
                                Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}"
                                Padding="4" Margin="8,0,0,0">
                            <TextBlock Text="🗑️" FontSize="16"/>
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- Lançar Custo Section -->
        <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <StackPanel Margin="20">
            <TextBlock Text="Lançar Custo" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

            <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
              <!-- Prestador Selection -->
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Prestador *" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding Contractors}"
                          SelectedItem="{Binding SelectedContractor}"
                          DisplayMemberPath="Name"
                          Background="White"
                          Foreground="Black"
                          Height="36" />
              </StackPanel>

              <!-- Amount and Date Grid -->
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Valor (R$) *" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                  <TextBox Text="{Binding CostAmount, UpdateSourceTrigger=PropertyChanged}"
                           Tag="0,00"
                           Background="White"
                           Foreground="Black"
                           CaretBrush="Black"
                           Height="36"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Data do Serviço" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                  <DatePicker SelectedDate="{Binding CostServiceDate}"
                              Height="36"/>
                </StackPanel>
              </Grid>

              <!-- Description -->
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Descrição do Serviço" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <TextBox Text="{Binding CostDescription, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Ex: Reparo no motor do compressor..."
                         Background="White"
                         Foreground="Black"
                         CaretBrush="Black"
                         AcceptsReturn="True"
                         Height="80"
                         VerticalScrollBarVisibility="Auto"/>
              </StackPanel>

              <!-- Submit Button -->
              <Button Content="Salvar Custo" 
                      Command="{Binding AddCostCommand}"
                      Style="{StaticResource PrimaryButton}"
                      Background="{StaticResource ErrorBrush}"
                      Foreground="White"
                      Height="36"/>
            </StackPanel>

            <TextBlock Text="Apenas administradores podem lançar custos." 
                       FontSize="12" 
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Cost History Section -->
      <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel Margin="20">
          <TextBlock Text="Histórico de Custos" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
            <ItemsControl ItemsSource="{Binding CostsView}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource BackgroundBrush}" CornerRadius="4" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                          <TextBlock Text="{Binding ContractorName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                          <Border Background="{StaticResource BorderBrush}" CornerRadius="2" Padding="4,2" Margin="8,0,0,0" Visibility="{Binding Specialty, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding Specialty}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ServiceDate, StringFormat=dd/MM/yyyy}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                      </StackPanel>

                      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Amount, StringFormat='R$ {0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Right" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}">
                          <Button Command="{Binding DataContext.EditCostCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                  CommandParameter="{Binding}"
                                  Style="{StaticResource SecondaryButton}"
                                  Foreground="{StaticResource PrimaryBrush}"
                                  Padding="4"
                                  Margin="0,0,4,0">
                            <TextBlock Text="✏️" FontSize="16"/>
                          </Button>
                          <Button Command="{Binding DataContext.DeleteCostCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                  CommandParameter="{Binding}"
                                  Style="{StaticResource SecondaryButton}"
                                  Foreground="{StaticResource ErrorBrush}"
                                  Padding="4">
                            <TextBlock Text="🗑️" FontSize="16"/>
                          </Button>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
