<Page x:Class="TTXEquipamentos.Views.Pages.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}"
      Title="Dashboard">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="1200">

      <!-- ═══════════════════════════════════════════════ -->
      <!-- WELCOME BANNER (bg-industrial-gradient)        -->
      <!-- ═══════════════════════════════════════════════ -->
      <Border CornerRadius="12" Padding="28,24" Margin="0,0,0,24">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3D1A08" Offset="0"/>
            <GradientStop Color="#5C2D15" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock FontSize="28" FontWeight="Bold" Foreground="White">
              <TextBlock.Text>
                <Binding Path="Greeting" StringFormat="{}{0}, "/>
              </TextBlock.Text>
            </TextBlock>
            <TextBlock Text="{Binding UserName}" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="!" FontSize="28" FontWeight="Bold" Foreground="White"/>
          </StackPanel>
          <TextBlock Text="{Binding RoleDescription}" FontSize="14" Foreground="#D4B896" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- ═══════════════════════════════════════════════ -->
      <!-- STATS GRID - 5 KPI CARDS                       -->
      <!-- ═══════════════════════════════════════════════ -->
      <UniformGrid Columns="5" Margin="0,0,0,24">

        <!-- Card 1: Preventivas (Mês) -->
        <Border Background="White" CornerRadius="8" Padding="20,16" Margin="0,0,8,0" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="Preventivas (Mês)" FontSize="13" FontWeight="Medium" 
                         Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="8"
                      Background="#EBF5FF" HorizontalAlignment="Right">
                <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </DockPanel>
            <TextBlock Text="{Binding PreventiveCount}" FontSize="30" FontWeight="Bold" 
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="ordens de serviço" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <!-- Card 2: Corretivas (Mês) -->
        <Border Background="White" CornerRadius="8" Padding="20,16" Margin="4,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="Corretivas (Mês)" FontSize="13" FontWeight="Medium"
                         Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="8"
                      Background="#FEF2F2" HorizontalAlignment="Right">
                <TextBlock Text="⚠" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#EF4444"/>
              </Border>
            </DockPanel>
            <TextBlock Text="{Binding CorrectiveCount}" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="ordens de serviço" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <!-- Card 3: Máquinas Cadastradas -->
        <Border Background="White" CornerRadius="8" Padding="20,16" Margin="4,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="Máquinas Cadastradas" FontSize="13" FontWeight="Medium"
                         Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="8"
                      Background="#F0FDF4" HorizontalAlignment="Right">
                <TextBlock Text="🔧" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </DockPanel>
            <TextBlock Text="{Binding MachineCount}" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="equipamentos" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <!-- Card 4: Total do Mês -->
        <Border Background="White" CornerRadius="8" Padding="20,16" Margin="4,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="Total do Mês" FontSize="13" FontWeight="Medium"
                         Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="8"
                      Background="#FFF4EB" HorizontalAlignment="Right">
                <TextBlock Text="📊" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </DockPanel>
            <TextBlock Text="{Binding TotalMonth}" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="manutenções realizadas" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <!-- Card 5: Custo Mão de Obra Extra (red accent) -->
        <Border CornerRadius="8" Padding="20,16" Margin="8,0,0,0"
                Background="#FEF8F8" BorderBrush="#FECACA" BorderThickness="1">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="Custo Mão de Obra Extra" FontSize="13" FontWeight="Medium"
                         Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="8"
                      Background="#FEE2E2" HorizontalAlignment="Right">
                <TextBlock Text="💲" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </DockPanel>
            <TextBlock Text="{Binding ExtraCostsFormatted}" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource ErrorBrush}"/>
            <TextBlock Text="total 2026" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- ═══════════════════════════════════════════════ -->
      <!-- BOTTOM ROW: AÇÕES RÁPIDAS + STATUS DO SISTEMA  -->
      <!-- ═══════════════════════════════════════════════ -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ações Rápidas -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="20,16,20,12">
              <TextBlock Text="🕐" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Ações Rápidas" FontSize="16" FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- Action Items -->
            <StackPanel Margin="16,0,16,16">
              <!-- Nova Ordem de Serviço -->
              <Button Command="{Binding NavigateToNewOSCommand}"
                      Visibility="{Binding ShowNewOS, Converter={StaticResource BoolToVisibilityConverter}}"
                      Cursor="Hand" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                      Padding="0" BorderThickness="0" Background="Transparent">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="ActionBorder" CornerRadius="8" Padding="16"
                            BorderBrush="#E8E3DE" BorderThickness="1" Background="White">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="8" Background="#FFF4EB" Margin="0,0,12,0">
                          <TextBlock Text="#181818ff" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Nova Ordem de Serviço" FontSize="14" FontWeight="Medium" Foreground="#141414ff"/>
                          <TextBlock Text="Registrar manutenção preventiva ou corretiva" FontSize="12" Foreground="#141414ff"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ActionBorder" Property="Background" Value="#FAF8F6"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>

              <!-- Ver Indicadores -->
              <Button Command="{Binding NavigateToIndicatorsCommand}"
                      Visibility="{Binding ShowIndicators, Converter={StaticResource BoolToVisibilityConverter}}"
                      Cursor="Hand" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                      Padding="0" BorderThickness="0" Background="Transparent">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="ActionBorder" CornerRadius="8" Padding="16"
                            BorderBrush="#E8E3DE" BorderThickness="1" Background="White">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="8" Background="#EBF5FF" Margin="0,0,12,0">
                          <TextBlock Text="📈" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Ver Indicadores" FontSize="14" FontWeight="Medium" Foreground="#14110E"/>
                          <TextBlock Text="Acompanhar KPIs e métricas de manutenção" FontSize="12" Foreground="#4B4239"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ActionBorder" Property="Background" Value="#FAF8F6"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>

              <!-- Gerenciar Máquinas -->
              <Button Command="{Binding NavigateToMachinesCommand}"
                      Visibility="{Binding ShowMachines, Converter={StaticResource BoolToVisibilityConverter}}"
                      Cursor="Hand" HorizontalAlignment="Stretch"
                      Padding="0" BorderThickness="0" Background="Transparent">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="ActionBorder" CornerRadius="8" Padding="16"
                            BorderBrush="#E8E3DE" BorderThickness="1" Background="White">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="8" Background="#F0FDF4" Margin="0,0,12,0">
                          <TextBlock Text="🔧" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Gerenciar Máquinas" FontSize="14" FontWeight="Medium" Foreground="#14110E"/>
                          <TextBlock Text="Cadastrar e editar equipamentos" FontSize="12" Foreground="#4B4239"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ActionBorder" Property="Background" Value="#FAF8F6"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Status do Sistema -->
        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="20,16,20,12">
              <TextBlock Text="📡" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Status do Sistema" FontSize="16" FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- Status Items -->
            <StackPanel Margin="16,0,16,16">
              <!-- Sistema -->
              <Border CornerRadius="8" Padding="14" Background="#FAF8F6" Margin="0,0,0,8">
                <DockPanel>
                  <TextBlock Text="Sistema" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                             VerticalAlignment="Center"/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                    <TextBlock Text="Operacional" FontSize="13" Foreground="#10B981" FontWeight="Medium"/>
                  </StackPanel>
                </DockPanel>
              </Border>

              <!-- Banco de Dados -->
              <Border CornerRadius="8" Padding="14" Background="#FAF8F6" Margin="0,0,0,8">
                <DockPanel>
                  <TextBlock Text="Banco de Dados" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                             VerticalAlignment="Center"/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                    <TextBlock Text="Conectado" FontSize="13" Foreground="#10B981" FontWeight="Medium"/>
                  </StackPanel>
                </DockPanel>
              </Border>

              <!-- Última Sincronização -->
              <Border CornerRadius="8" Padding="14" Background="#FAF8F6">
                <DockPanel>
                  <TextBlock Text="Última Sincronização" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                             VerticalAlignment="Center"/>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentTime}" FontSize="13"
                             Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"
                             VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Loading indicator -->
      <TextBlock Text="Carregando dados..." Foreground="{StaticResource TextSecondaryBrush}"
                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                 HorizontalAlignment="Center" Margin="0,16,0,0"/>

    </StackPanel>
  </ScrollViewer>
</Page>
