<Page x:Class="TTXEquipamentos.Views.Pages.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}"
      Title="Perfil">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24" MaxWidth="700" HorizontalAlignment="Left">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock Text="Meu Perfil" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="Informações do usuário logado no sistema" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,4,0,0"/>
      </StackPanel>

      <StackPanel>
        <Border Background="White" CornerRadius="8" Padding="32" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,24">
          <StackPanel>

            <!-- Avatar Placeholder -->
            <Border Width="80" Height="80" CornerRadius="40" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Left" Margin="0,0,0,24">
              <TextBlock Text="{Binding UserName, Converter={StaticResource InitialsConverter}}"
                         FontSize="28" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Grid Margin="0,0,0,20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UserName}" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="E-mail" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UserEmail}" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>

              <TextBlock Grid.Row="4" Grid.Column="0" Text="Nível de Acesso" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
              <Border Grid.Row="4" Grid.Column="1" CornerRadius="12" Background="{StaticResource PrimaryBrush}" Padding="12,4" HorizontalAlignment="Left">
                <TextBlock Text="{Binding UserRole}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
              </Border>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Change Password Card -->
        <Border Background="White" CornerRadius="8" Padding="32" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,24">
          <StackPanel>
            <TextBlock Text="Alterar Senha" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>
            
            <TextBlock Text="Nova Senha" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
            <TextBox Margin="0,0,0,16"
                     Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"/>
            
            <TextBlock Text="Confirmar Nova Senha" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
            <TextBox Margin="0,0,0,24"
                     Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Content="Alterar Senha" Style="{StaticResource PrimaryButton}"
                    Background="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}" Foreground="White"
                    Command="{Binding ChangePasswordCommand}" HorizontalAlignment="Left" Padding="24,8"/>
          </StackPanel>
        </Border>

        <!-- Permissions Card -->
        <Border Background="White" CornerRadius="8" Padding="32" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,24">
          <StackPanel>
            <TextBlock Text="Permissões do seu Perfil" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
            
            <ItemsControl ItemsSource="{Binding Permissions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>