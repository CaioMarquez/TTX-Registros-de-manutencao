<Page x:Class="TTXEquipamentos.Views.Pages.AlertSettings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}"
      Title="Configurações de Alertas">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24" MaxWidth="700" HorizontalAlignment="Left">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock Text="Configurações de Alertas" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="Configure notificações e alertas automáticos por e-mail" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,4,0,0"/>
      </StackPanel>

      <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="32" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>

          <!-- Enable Toggle -->
          <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
            <CheckBox IsChecked="{Binding AlertsEnabled}" VerticalAlignment="Center"
                      Style="{StaticResource CheckBoxStyle}"/>
            <StackPanel Margin="12,0,0,0">
              <TextBlock Text="Habilitar Alertas" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
              <TextBlock Text="Ativa o envio automático de notificações por e-mail" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
          </StackPanel>

          <Separator Margin="0,0,0,24"/>

          <!-- Email Recipient -->
          <TextBlock Text="E-mail de Destino" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
          <TextBox Text="{Binding EmailRecipient, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource InputTextBox}"
                   Height="40" Margin="0,0,0,24" Padding="8,6"/>

          <!-- Frequency -->
          <TextBlock Text="Frequência dos Alertas" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
          <ComboBox SelectedValue="{Binding AlertFrequency}"
                    Height="40" Margin="0,0,0,32">
            <ComboBoxItem Content="Diário" Tag="diario"/>
            <ComboBoxItem Content="Semanal" Tag="semanal"/>
            <ComboBoxItem Content="Mensal" Tag="mensal"/>
          </ComboBox>

          <!-- Save -->
          <StackPanel Orientation="Horizontal">
            <Button Content="Salvar Configurações"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Background="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}"
                    Foreground="White" Height="48" FontSize="14" Cursor="Hand"
                    Padding="24,0"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                       Foreground="{StaticResource SuccessBrush}" FontSize="14" FontWeight="SemiBold" Margin="16,0,0,0"/>
          </StackPanel>

        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Page>