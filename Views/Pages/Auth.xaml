<Page x:Class="TTXEquipamentos.Views.Pages.Auth"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="500"
      Background="{StaticResource BackgroundBrush}"
      Title="TTX - Login">

    <Grid>
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
            <Border Style="{StaticResource Card}" Width="450" MinHeight="700">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0">
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                        <TextBlock Text="TTX Equipamentos" 
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="Sistema de Manutenção" 
                                   FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,20" />

                    <TabControl Margin="0,0,0,20">
                        <TabItem Header="Entrar" Foreground="{StaticResource TextPrimaryBrush}">
                            <StackPanel Margin="16,16,16,0">
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Email" 
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,6" />
                                    <TextBox x:Name="LoginEmailTextBox"
                                             Style="{StaticResource InputTextBox}"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                             Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Senha" 
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,6" />
                                    <PasswordBox x:Name="LoginPasswordBox"
                                                 Style="{StaticResource InputPasswordBox}"
                                                 PasswordChanged="LoginPasswordBox_PasswordChanged"
                                                 Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>

                                <TextBlock x:Name="LoginErrorTextBlock"
                                           Text="{Binding ErrorMessage}"
                                           Foreground="{StaticResource ErrorBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"
                                           Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <Button Content="Entrar"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="LoginButton_Click"
                                        Margin="0,0,0,16"
                                        Padding="16,12" />
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Registrar" Foreground="{StaticResource TextPrimaryBrush}">
                            <StackPanel Margin="16,16,16,0">
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Nome Completo" 
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,6" />
                                    <TextBox x:Name="SignupNameTextBox"
                                             Style="{StaticResource InputTextBox}"
                                             Text="{Binding SignupName, UpdateSourceTrigger=PropertyChanged}"
                                             Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Email" 
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,6" />
                                    <TextBox x:Name="SignupEmailTextBox"
                                             Style="{StaticResource InputTextBox}"
                                             Text="{Binding SignupEmail, UpdateSourceTrigger=PropertyChanged}"
                                             Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Senha" 
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,6" />
                                    <PasswordBox x:Name="SignupPasswordBox"
                                                 Style="{StaticResource InputPasswordBox}"
                                                 PasswordChanged="SignupPasswordBox_PasswordChanged"
                                                 Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Confirmar Senha" 
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,6" />
                                    <PasswordBox x:Name="SignupConfirmPasswordBox"
                                                 Style="{StaticResource InputPasswordBox}"
                                                 PasswordChanged="SignupConfirmPasswordBox_PasswordChanged"
                                                 Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>

                                <TextBlock x:Name="SignupErrorTextBlock"
                                           Text="{Binding SignupErrorMessage}"
                                           Foreground="{StaticResource ErrorBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"
                                           Visibility="{Binding SignupErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <Button Content="Criar Conta"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="SignupButton_Click"
                                        Margin="0,0,0,16"
                                        Padding="16,12" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                    <Button x:Name="MasterAdminButton"
                            Content="🔧" 
                            FontSize="28"
                            Width="60" Height="60"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="MasterAdminButton_Click"
                            Foreground="{StaticResource TextSecondaryBrush}" 
                            Margin="0,0,0,20"
                            ToolTip="Clique 5 vezes para ativar acesso de master"/>

                    <TextBlock x:Name="StatusMessageTextBlock"
                               Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12" />
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="SignupDialogOverlay" 
              Background="#000000" 
              Opacity="0.5" 
              Panel.ZIndex="100"
              Visibility="{Binding SignupDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Border x:Name="SignupDialogBorder" 
                Panel.ZIndex="101"
                Background="White" 
                CornerRadius="8" 
                Padding="24"
                Width="420"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Visibility="{Binding SignupDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="6" Color="#000000" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Aguardando aprovação" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Sua conta foi criada com sucesso." FontSize="13" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding SignupDialogMessage}" FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Fechar" Style="{StaticResource SecondaryButton}" Command="{Binding CloseSignupDialogCommand}" Padding="8,4" MinWidth="80"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>